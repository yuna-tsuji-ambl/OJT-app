{
  "name": "ojt-app",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @ojt-app/web",
    "dev:api": "npm run dev -w @ojt-app/api",
    "dev:api:firestore": "DB_PROVIDER=firestore GCP_PROJECT_ID=ojt-app FIRESTORE_EMULATOR_HOST=127.0.0.1:8081 npm run dev -w @ojt-app/api",
    "dev:all": "concurrently \"npm run dev:api\" \"npm run dev\"",
    "dev:all:firestore": "concurrently \"npm run emulators:firestore\" \"npm run dev:api:firestore\" \"npm run dev\"",
    "emulators:firestore": "firebase emulators:start --only firestore",
    "build": "npm run build -w @ojt-app/shared && npm run build -w @ojt-app/api && npm run build -w @ojt-app/web",
    "test": "npm run test -w @ojt-app/api",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start": "npm run start -w @ojt-app/api",
    "prepare": "node scripts/prepare-husky.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.50.1",
    "concurrently": "^9.1.2",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "firebase-tools": "^13.29.1",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.9.4",
    "typescript-eslint": "^8.62.1"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "npx eslint --fix",
      "npx prettier --write"
    ],
    "*.{json,md,css,yml,yaml,html}": [
      "npx prettier --write"
    ]
  }
}
